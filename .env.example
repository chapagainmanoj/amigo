# Channel — "telegram" (default) or "cli" (local dev, no external services)
# APP_CHANNEL=cli

# Telegram (not needed when APP_CHANNEL=cli)
TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather
TELEGRAM_WEBHOOK_SECRET=generate-a-random-string-here
ACCESS_MODE=open  # production: closed, allowlist, or invite
ALLOWED_TELEGRAM_CHAT_IDS=  # required and non-empty in allowlist mode

# Supabase (not needed when APP_CHANNEL=cli)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Google AI
GOOGLE_API_KEY=your-gemini-api-key

# App
APP_BASE_URL=https://your-ngrok-url.ngrok-free.app
APP_ENV=development
LOG_LEVEL=INFO

# Dashboard & API authentication
DASHBOARD_URL=http://localhost:5173


# Owner-controlled model routing; participants cannot supply keys or choose models.
DEFAULT_MODEL=gemini-3.5-flash
DEV_MODEL=  # development only: claude-cli:sonnet or ollama:qwen3.5:4b
OLLAMA_BASE_URL=http://localhost:11434/v1
MODE_MODELS=  # comma-separated: daily=google:gemini-3.5-flash
# Production Mode overrides require current entries in evals/model-evidence.json.
# Pins are only for owner/internal dogfooding IDs, exempt from evaluation allowlisting.
# NEVER pin real participants to Anthropic: decision 04 requires renewed processor consent.
PARTICIPANT_MODEL_PINS=  # internal-user-id=anthropic:claude-haiku-5-5
ANTHROPIC_API_KEY=  # platform key, supplied by owner; never participant keys
OPENAI_API_KEY=  # platform key for openai:<model> routes
DEEPSEEK_API_KEY=  # platform key for deepseek:<model> routes
# Providers: google:<model> (e.g. gemini-3.5-flash-lite), anthropic:, openai:, deepseek:.
# Production refuses a DEFAULT_MODEL/MODE_MODELS provider not listed here. Listing a new one
# is a privacy decision (decision 04): update the notice and participant consent first.
# A non-Gemini DEFAULT_MODEL also needs evals/model-evidence.json entries for every live Mode.
APPROVED_MODEL_PROVIDERS=google
